{
  "$schema": "https://mintlify.com/docs.json",
  "name": "fentaris",
  "theme": "almond",
  "colors": {
    "primary": "#0C0C0C",
    "light": "#FFFFFF",
    "dark": "#0C0C0C"
  },
  "description": "The centralized MCP proxy for routing tools, enforcing policy, and shipping observability.",
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "Google Sans"
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#FFFFFF",
      "dark": "#0C0C0C"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Home",
        "pages": ["index"]
      },
      {
        "group": "Documentation",
        "pages": [
          {
            "group": "Get Started",
            "expanded": true,
            "pages": [
              "getting-started/quickstart",
              "getting-started/installation",
              "getting-started/codex-skills",
              "getting-started/setup",
              "getting-started/tutorial"
            ]
          },
          {
            "group": "Concepts",
            "expanded": false,
            "pages": [
              "concepts/architecture",
              "concepts/servers-and-transports",
              "concepts/identity-and-auth",
              "concepts/policies",
              "concepts/observability"
            ]
          },
          {
            "group": "Guides",
            "expanded": false,
            "pages": [
              "guides/proxy-setup",
              "guides/middleware",
              "guides/hooks",
              "guides/multi-server",
              "guides/observability",
              "guides/logger",
              "guides/flows",
              "guides/end-to-end",
              "guides/error-handling",
              "guides/governance-auth",
              "guides/telegram-approval",
              "guides/security"
            ]
          },
          "troubleshooting",
          {
            "group": "Reference",
            "expanded": false,
            "pages": [
              "reference/cli",
              "reference/config-file",
              "reference/environment-variables",
              "reference/mcp-proxy",
              "reference/mcp-server",
              "reference/stdio-transport",
              "reference/logger",
              "reference/extension-api",
              "reference/types",
              "reference-auto/index",
              "reference-auto/status"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/Fentaris/fentaris"
      }
    ]
  }
}
